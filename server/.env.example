# Copy to .env (chmod 600) and fill in. Never commit .env.
PORT=3100
HOST=127.0.0.1
# DB_FILE=/opt/italian-words/server/data/words.db

# Google AI Studio keys, comma separated (rotated, 429 -> next key)
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemma-4-31b-it
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_ATTEMPTS=6
# Deadline for one lookup across all keys/models (the app should wait ~60s)
GEMINI_TOTAL_MS=50000
# Max Gemini calls per day for the whole server (cost guard)
GEMINI_DAILY_MAX=5000

# Admin endpoints (Bearer token, at least 16 chars). Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# Per-IP limits
RATE_LOOKUP_PER_MIN=30
RATE_LOOKUP_PER_DAY=1000
RATE_UPDATES_PER_MIN=60
RATE_UPDATES_PER_DAY=5000

# nginx is on the same machine
TRUST_PROXY=loopback
